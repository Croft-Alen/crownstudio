{
  "version": 2,
  "builds": [
    {
      "src": "dist/server/entry.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "dist/client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/test.html",
      "dest": "/dist/client/test.html"
    },
    {
      "src": "/_astro/(.*)",
      "dest": "/dist/client/_astro/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/server/entry.mjs"
    }
  ]
}