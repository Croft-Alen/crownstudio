{
  "builds": [
    {
      "src": "dist/server/entry.mjs",
      "use": "@vercel/node",
      "config": {
        "runtime": "nodejs20.x"
      }
    }
  ],
  "routes": [
    {
      "src": "/_astro/(.*)",
      "dest": "/dist/client/_astro/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/dist/client/images/$1"
    },
    {
      "src": "/favicon.*",
      "dest": "/dist/client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dist/server/entry.mjs"
    }
  ]
}