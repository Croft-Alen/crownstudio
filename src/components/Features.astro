---
import { getPageData } from '../data/pages.js';

const pageData = getPageData('home');
const features = pageData.features;

const iconMap: Record<string, string> = {
  settings: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z',
  rocket: 'M13 10V3L4 14h7v7l9-11h-7z',
  check: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  link: 'M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z',
  star: 'M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5',
  refresh: 'M13 10V3L4 14h7v7l9-11h-7z',
  heart: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  user: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  globe: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  shield: 'M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4'
};
---

<section class="py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex justify-center mb-4">
      <span class="inline-block bg-brand text-white text-xs font-semibold tracking-[0.08em] uppercase px-4 py-1.5 rounded-full">
        {features.tag}
      </span>
    </div>
    
    <h2 class="text-3xl md:text-4xl font-bold text-center text-text-heading mb-3">
      {features.heading}
    </h2>
    
    <p class="text-center text-text-muted text-base max-w-2xl mx-auto mb-12">
      {features.subtext}
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[220px]">
      {features.features.map((feature: any, index: number) => {
        const iconKey = feature.icon || 'settings';
        const iconPath = iconMap[iconKey] || iconMap.settings;
        const isFirst = index === 0;
        const spanClasses = isFirst ? 'lg:col-span-2 lg:row-span-2' : '';
        const stats = feature.stats || [];
        return (
          <div class={`relative bg-card-bg rounded-2xl border border-border shadow-sm hover:shadow-xl transition-all duration-500 group overflow-hidden hover:-translate-y-1 ${spanClasses}`}>
            <div class="absolute inset-0 bg-gradient-to-br from-brand/5 via-transparent to-brand/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative p-6 h-full flex flex-col">
              <div class="mb-4">
                <div class="w-12 h-12 rounded-full bg-brand/10 flex items-center justify-center group-hover:bg-brand/20 transition-all duration-300 group-hover:scale-110">
                  <svg class="w-6 h-6 text-brand group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconPath}/>
                  </svg>
                </div>
              </div>
              <h3 class="font-semibold text-text-heading text-lg mb-2 group-hover:text-brand transition-colors duration-300">{feature.title}</h3>
              <p class="text-text-muted text-sm leading-relaxed group-hover:text-text-body/80 transition-colors duration-300">{feature.description}</p>
              
              {isFirst && stats.length > 0 && (
                <div class="mt-4 pt-4 border-t border-border/50 space-y-2.5">
                  {stats.map((stat: any, idx: number) => (
                    <div key={idx} class="flex items-center gap-3 text-text-body/70 text-sm">
                      <svg class="w-5 h-5 text-brand shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d={iconMap[stat.icon] || iconMap.check}/>
                      </svg>
                      <span>{stat.label}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>