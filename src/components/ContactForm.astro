---
import siteConfig from '../data/site-config.json';
const contact = siteConfig.contact;
---

<section class="py-16 bg-transparent">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <div class="flex justify-center mb-4">
        <span class="inline-block bg-brand text-white text-xs font-semibold tracking-[0.08em] uppercase px-4 py-1.5 rounded-full">
          Contact Us
        </span>
      </div>
      <h2 class="text-3xl font-bold text-text-heading mb-3">Get in Touch</h2>
      <p class="text-text-muted text-base max-w-2xl mx-auto">
        Have questions? We'd love to hear from you. Reach out and we'll get back to you within 24 hours.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <div class="lg:col-span-2">
        <div class="bg-card-bg rounded-2xl border border-border shadow-xl p-8 md:p-10">
          <div class="flex items-center gap-3 mb-6">
            <svg class="w-6 h-6 text-brand flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <h2 class="text-xl font-bold text-text-heading">Send us a Message</h2>
          </div>
          
          <form 
            action="https://formspree.io/f/your-form-id" 
            method="POST"
            class="space-y-5"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-medium text-text-muted mb-1.5">Your Name</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  class="w-full px-4 py-2.5 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent bg-white/50 text-text-body transition-all duration-300"
                  placeholder="John Doe"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-text-muted mb-1.5">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  class="w-full px-4 py-2.5 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent bg-white/50 text-text-body transition-all duration-300"
                  placeholder="john@example.com"
                />
              </div>
            </div>
            
            <div>
              <label for="subject" class="block text-sm font-medium text-text-muted mb-1.5">Subject</label>
              <input 
                type="text" 
                id="subject" 
                name="subject" 
                class="w-full px-4 py-2.5 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent bg-white/50 text-text-body transition-all duration-300"
                placeholder="How can we help?"
              />
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-text-muted mb-1.5">Your Message</label>
              <textarea 
                id="message" 
                name="message" 
                rows="5"
                required
                class="w-full px-4 py-2.5 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent bg-white/50 text-text-body transition-all duration-300 resize-none"
                placeholder="Tell us about your project..."
              ></textarea>
            </div>
            
            <button 
              type="submit"
              class="w-full bg-brand text-white font-semibold px-6 py-3 rounded-lg transition-all duration-300 shadow-md hover:shadow-xl"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
      
      <div class="lg:col-span-1">
        <div class="bg-card-bg rounded-2xl border border-border shadow-xl p-8">
          <h3 class="text-lg font-bold text-text-heading mb-6">Contact Information</h3>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-brand/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-text-muted uppercase tracking-wider">Email</p>
                <a href={`mailto:${contact.email}`} class="text-text-body hover:text-brand transition-colors text-sm">
                  {contact.email}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-brand/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-text-muted uppercase tracking-wider">Discord</p>
                <p class="text-text-body text-sm">{contact.discord}</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-brand/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-text-muted uppercase tracking-wider">Response Time</p>
                <p class="text-text-body text-sm">{contact.responseTime}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>