---
import siteConfig from '../data/site-config.json';
import categoriesData from '../data/categories.json';

const { siteName, logo, socialLinks, contact, siteDescription } = siteConfig;
const currentYear = new Date().getFullYear();

const categories = categoriesData || [];
---

<footer class="relative bg-brand text-white overflow-hidden rounded-2xl shadow-lg border border-brand-dark/30 mx-4 mt-4 mb-4">
  
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/footer-bg.webp" 
      alt="Footer background"
      class="w-full h-full object-cover opacity-[0.06]"
      loading="lazy"
    />
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      
      <div class="md:col-span-6">
        <div class="flex items-center gap-3 mb-3">
          <img src={logo} alt={siteName} class="w-11 h-11 object-contain" />
          <span class="text-xl font-bold text-white">{siteName}</span>
        </div>
        <p class="text-white/80 text-sm mb-4 max-w-sm">
          {siteDescription}
        </p>
        <div class="flex gap-4">
          <a href={socialLinks.discord} target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          </a>
          <a href={`mailto:${contact.email}`} class="text-white/70 hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round"stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </a>
          <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <div class="md:col-span-3">
        <h3 class="font-semibold text-base text-white mb-3">Quick Links</h3>
        <ul class="space-y-2">
          {siteConfig.navLinks.map((link) => (
            <li>
              <a href={link.url} class="text-white/70 hover:text-white transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="font-semibold text-base text-white mb-3">Shop</h3>
        <ul class="space-y-2">
          {categories.map((cat) => (
            <li>
              <a href={`/products?category=${cat.slug}`} class="text-white/70 hover:text-white transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-8 pt-8 flex flex-col sm:flex-row justify-between items-center text-sm text-white/50">
      <span>© {currentYear} {siteName}. All rights reserved.</span>
    </div>
  </div>
</footer>