---
import { products } from '../data/products.js';
import categoriesData from '../data/categories.json';
import { getPageData } from '../data/pages.js';

const pageData = getPageData('home');
const categoriesSection = pageData.categories;

const categories = categoriesData.map(cat => {
  const count = products.filter(p => p.category === cat.slug).length;
  return {
    ...cat,
    count: count
  };
});
---

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <div class="flex justify-center mb-4">
        <span class="inline-block bg-brand text-white text-xs font-semibold tracking-[0.08em] uppercase px-4 py-1.5 rounded-full">
          {categoriesSection.tag}
        </span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-text-heading mb-3">
        {categoriesSection.heading}
      </h2>
      <p class="text-text-muted text-base max-w-2xl mx-auto">
        {categoriesSection.subtext}
      </p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => {
        const imageUrl = cat.image && cat.image !== `/images/categories/${cat.slug}.jpg` 
          ? cat.image 
          : `https://picsum.photos/seed/${cat.slug}/600/350`;
        
        return (
          <a 
            href={`/products?category=${cat.slug}`}
            class="group relative bg-card-bg rounded-2xl border border-border shadow-sm hover:shadow-xl overflow-hidden transition-all duration-300 hover:-translate-y-1"
          >
            <div class="relative aspect-[5/2.5] overflow-hidden bg-gray-100">
              <img 
                src={imageUrl}
                alt={cat.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
              <div class="absolute bottom-4 sm:bottom-5 left-4 sm:left-5 right-4 sm:right-5">
                <h3 class="text-xl sm:text-2xl font-bold text-white">{cat.name}</h3>
              </div>
            </div>
            <div class="relative p-4 flex justify-between items-center z-10">
              <span class="text-sm text-text-body">{cat.description}</span>
              <span class="inline-flex items-center gap-2 bg-brand text-white text-xs font-semibold px-4 py-2 rounded-full whitespace-nowrap shrink-0 ml-2 shadow-md">
                {categoriesSection.buttonText}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>