---
import "../styles/global.css";
import Sidebar from '../components/admin/Sidebar.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CMS Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-page-bg font-sans">
    <div class="flex min-h-screen lg:h-screen overflow-hidden">
      <Sidebar />
      <div class="flex-1 flex flex-col min-h-screen lg:h-screen overflow-hidden">
        <main class="flex-1 overflow-y-auto p-4 md:p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>