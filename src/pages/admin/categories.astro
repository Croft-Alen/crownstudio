---
import AdminLayout from '../../layouts/AdminLayout.astro';
import categoriesData from '../../data/categories.json';

const session = Astro.cookies.get('admin_session');
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout>
  <div class="max-w-5xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-bold text-text-heading">Categories</h1>
        <p class="text-text-muted text-sm mt-1">Manage your product categories</p>
      </div>
      <a 
        href="/admin/categories/create" 
        class="bg-brand text-white px-4 py-2 rounded-lg hover:bg-brand/80 transition-colors flex items-center gap-2 text-sm font-medium shrink-0"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Add New Category
      </a>
    </div>

    <div class="bg-card-bg rounded-xl border border-border shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[600px]">
          <thead class="bg-white/50 border-b border-border">
            <tr>
              <th class="text-left px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Name</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Slug</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Description</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Order</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody>
            {categoriesData.sort((a, b) => (a.order || 0) - (b.order || 0)).map((cat) => (
              <tr class="border-b border-border hover:bg-white/30 transition-colors">
                <td class="px-4 py-3">
                  <span class="text-sm font-medium text-text-heading">{cat.name}</span>
                </td>
                <td class="px-4 py-3">
                  <span class="text-sm text-text-body font-mono">{cat.slug}</span>
                </td>
                <td class="px-4 py-3 text-sm text-text-muted max-w-xs truncate">{cat.description || '—'}</td>
                <td class="px-4 py-3 text-sm text-text-body text-center">{cat.order || 0}</td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <a 
                      href={`/admin/categories/${cat.slug}`}
                      class="text-brand hover:text-brand/80 text-sm font-medium transition-colors"
                    >
                      Edit
                    </a>
                    <span class="text-border">|</span>
                    <a 
                      href={`/api/categories/delete/${cat.slug}`}
                      class="text-red-500 hover:text-red-600 text-sm font-medium transition-colors"
                      onclick="return confirm('Delete this category?')"
                    >
                      Delete
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      
      {categoriesData.length === 0 && (
        <div class="text-center py-12">
          <p class="text-text-muted text-sm">No categories yet. Create your first category!</p>
        </div>
      )}
    </div>
  </div>
</AdminLayout>